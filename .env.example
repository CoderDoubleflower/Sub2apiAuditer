AUDITER_PORT=8080
# 使用两个不同的长随机 ASCII 令牌。留空意味着对应接口不鉴权。
ADMIN_TOKEN=
AUDITER_TOKEN=
LOG_LEVEL=info

# Docker 容器内路径；/data 映射到 Compose 文件旁的 ./data。
TRACE_DB_PATH=/data/auditer.db
LOG_CAPACITY=100

# 保留前缀的反代可设为 /auditer；根路径或 handle_path 剥离前缀时留空。
BASE_PATH=
FORWARDED_ALLOW_IPS=127.0.0.1

MAX_REQUEST_BODY_BYTES=2097152
MAX_INPUT_CHARS=200000
HTTP_MAX_CONNECTIONS=200
HTTP_MAX_KEEPALIVE=50

# 仅在 config.json 不存在时使用；通常在网页配置即可。
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
UPSTREAM_MODEL=
UPSTREAM_TIMEOUT_SECONDS=20
UPSTREAM_MAX_TOKENS=256
AUDIT_PROMPT=
